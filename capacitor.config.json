{
  "appId": "com.soma.calendar.preview",
  "appName": "Soma",
  "webDir": "www",
  "backgroundColor": "#050505",
  "loggingBehavior": "debug",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "scheme": "Soma",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#050505",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_notify",
      "iconColor": "#A8741C"
    }
  }
}
