<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Kaal Chakra: bone by day, OLED black by night (values-night/colors.xml). DayNight makes the WebView report
       prefers-color-scheme to the shared web app. -->
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="colorPrimary">@color/soma_ground</item>
    <item name="colorPrimaryDark">@color/soma_ground</item>
    <item name="colorAccent">@color/widget_gold</item>
    <item name="android:windowBackground">@color/soma_ground</item>
    <item name="android:statusBarColor">@color/soma_ground</item>
    <item name="android:navigationBarColor">@color/soma_ground</item>
    <item name="android:windowLightStatusBar">@bool/soma_light_bars</item>
    <item name="android:windowLightNavigationBar">@bool/soma_light_bars</item>
  </style>
  <style name="AppTheme.NoActionBar" parent="AppTheme">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:background">@null</item>
  </style>
  <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/soma_ground</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
  </style>
</resources>
