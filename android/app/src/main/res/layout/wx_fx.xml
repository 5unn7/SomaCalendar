<?xml version="1.0" encoding="utf-8"?>
<!-- The Sky widget's moving weather: every layer starts hidden; PanchangWidgets.sky() shows the ones the forecast calls for.
     Each ViewFlipper shows two copies of a pattern that is periodic in its own box and slides them with in/out
     animations whose duration equals flipInterval, so rain falls, snow drifts and clouds pass without a seam.
     Launchers pause flippers when the home screen is off or covered, so this costs nothing in the background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="noHideDescendants">
  <ViewFlipper android:id="@+id/fxGlow" android:layout_width="170dp" android:layout_height="170dp" android:layout_gravity="top|end" android:layout_marginTop="-55dp" android:layout_marginEnd="-45dp" android:visibility="gone" android:autoStart="true" android:flipInterval="2800" android:inAnimation="@anim/wx_fade_in" android:outAnimation="@anim/wx_fade_out"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wx_fx_glow_a" android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wx_fx_glow_b" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxStars" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="2800" android:inAnimation="@anim/wx_fade_in" android:outAnimation="@anim/wx_fade_out" ><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_stars_a" android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_stars_b" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxFog" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="30000" android:inAnimation="@anim/wx_cloud_in" android:outAnimation="@anim/wx_cloud_out" ><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_fog" android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_fog" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxClouds" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="30000" android:inAnimation="@anim/wx_cloud_in" android:outAnimation="@anim/wx_cloud_out" ><ImageView android:id="@+id/fxCloud1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_clouds" android:importantForAccessibility="no"/><ImageView android:id="@+id/fxCloud2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_clouds" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxRain" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="800" android:inAnimation="@anim/wx_fall_in" android:outAnimation="@anim/wx_fall_out" ><ImageView android:id="@+id/fxRain1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_rain" android:importantForAccessibility="no"/><ImageView android:id="@+id/fxRain2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_rain" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxSnow" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="6000" android:inAnimation="@anim/wx_snow_in" android:outAnimation="@anim/wx_snow_out" ><ImageView android:id="@+id/fxSnow1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_snow" android:importantForAccessibility="no"/><ImageView android:id="@+id/fxSnow2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_snow" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxWind" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="1600" android:inAnimation="@anim/wx_wind_in" android:outAnimation="@anim/wx_wind_out" ><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_wind" android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_wind" android:importantForAccessibility="no"/></ViewFlipper>
  <ViewFlipper android:id="@+id/fxFlash" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:autoStart="true" android:flipInterval="500" android:inAnimation="@anim/wx_flash_in" android:outAnimation="@anim/wx_flash_out" ><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wx_fx_flash" android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"  android:importantForAccessibility="no"/></ViewFlipper>
</FrameLayout>
