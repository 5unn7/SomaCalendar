<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2x2): the 24-hour Choghadiya ring with now, tithi and the current window drawn into one bitmap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
  android:padding="10dp" android:background="@drawable/widget_bg">
  <ImageView android:id="@+id/wRing" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="fitCenter" android:contentDescription="@string/widget_description"/>
</FrameLayout>
