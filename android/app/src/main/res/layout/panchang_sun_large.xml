<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:text="SUN" android:letterSpacing="0.14" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/pHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="22sp" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/pSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><ImageView android:id="@+id/pArt" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:adjustViewBounds="true" android:contentDescription="@string/widget_art" android:layout_marginTop="4dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/pRise" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_gold" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="start"/><TextView android:id="@+id/pSet" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="end"/></LinearLayout><TextView android:id="@+id/pDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="12sp" android:maxLines="5" android:ellipsize="end" android:layout_marginTop="10dp" android:lineSpacingExtra="4dp"/>
</LinearLayout>
