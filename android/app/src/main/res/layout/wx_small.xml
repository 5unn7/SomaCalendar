<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/wx_bg_night" android:clipToOutline="true">
  <include layout="@layout/wx_fx_sq"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/wPlace" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E0FFFFFF" android:shadowColor="#59000000" android:shadowRadius="6" android:shadowDy="1" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:letterSpacing="0.12"/>
      <ImageView android:id="@+id/wIcon" android:layout_width="26dp" android:layout_height="26dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
    </LinearLayout>
    <TextView android:id="@+id/wTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:shadowColor="#59000000" android:shadowRadius="6" android:shadowDy="1" android:textSize="40sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/wCond" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:shadowColor="#59000000" android:shadowRadius="6" android:shadowDy="1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/wSun" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E0FFFFFF" android:shadowColor="#59000000" android:shadowRadius="6" android:shadowDy="1" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
</FrameLayout>
