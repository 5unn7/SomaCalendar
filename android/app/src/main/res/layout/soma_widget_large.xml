<?xml version="1.0" encoding="utf-8"?>
<!-- Large (4x3 and up): the ring above, NOW and the next vrat below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
  <ImageView android:id="@+id/wRing" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:scaleType="fitCenter" android:contentDescription="@string/widget_description"/>
  <TextView android:id="@+id/wLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:text="NOW" android:textColor="@color/widget_muted" android:textSize="10sp"
    android:letterSpacing="0.14" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
  <TextView android:id="@+id/wNow" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Soma" android:textColor="@color/widget_ink" android:textSize="22sp" android:fontFamily="serif"
    android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/wThen" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/wVrat" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:textColor="@color/widget_gold" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
