<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <!-- Local vrat, parana and muhurat reminders: notifications, on-time alarms, and re-arming after a reboot. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <application android:allowBackup="false" android:fullBackupContent="false"
    android:icon="@drawable/soma_icon" android:label="Soma Preview" android:theme="@style/SomaTheme"
    android:usesCleartextTraffic="false" android:supportsRtl="true">
    <activity android:name="com.soma.calendar.MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <receiver android:name="com.soma.calendar.SomaWidget" android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider"
        android:resource="@xml/soma_widget_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Sun" android:exported="true" android:label="@string/widget_label_sun">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_sun_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Moon" android:exported="true" android:label="@string/widget_label_moon">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_moon_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Festival" android:exported="true" android:label="@string/widget_label_festival">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_festival_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Now" android:exported="true" android:label="@string/widget_label_now">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_now_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Day" android:exported="true" android:label="@string/widget_label_day">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_day_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Sky" android:exported="true" android:label="@string/widget_label_sky">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_sky_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Tick" android:exported="false">
      <intent-filter>
        <action android:name="com.soma.calendar.PANCHANG_WIDGET_TICK"/>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
      </intent-filter>
    </receiver>
    <!-- Twice-daily refresh of widgets and reminders while the app is closed; runs on the phone, offline. -->
    <service android:name="com.soma.calendar.RefreshJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false"/>
    <receiver android:name="com.soma.calendar.ReminderReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
