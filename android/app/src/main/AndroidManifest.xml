<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
    android:allowBackup="false"
    android:fullBackupContent="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:usesCleartextTraffic="false"
    android:theme="@style/AppTheme">

    <activity
      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
      android:name="com.soma.calendar.MainActivity"
      android:label="@string/title_activity_main"
      android:theme="@style/AppTheme.NoActionBarLaunch"
      android:launchMode="singleTask"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Home-screen widget: reads the week of Panchang the app shares (src/redesign/widget.js). -->
    <receiver android:name="com.soma.calendar.SomaWidget" android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider"
        android:resource="@xml/soma_widget_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Sun" android:exported="true" android:label="@string/widget_label_sun">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_sun_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Moon" android:exported="true" android:label="@string/widget_label_moon">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_moon_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Festival" android:exported="true" android:label="@string/widget_label_festival">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_festival_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Now" android:exported="true" android:label="@string/widget_label_now">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_now_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Day" android:exported="true" android:label="@string/widget_label_day">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/panchang_day_info"/>
    </receiver>
    <receiver android:name="com.soma.calendar.PanchangWidgets$Tick" android:exported="false">
      <intent-filter>
        <action android:name="com.soma.calendar.PANCHANG_WIDGET_TICK"/>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
      </intent-filter>
    </receiver>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths"/>
    </provider>
  </application>

  <!-- Capacitor serves the bundled app from https://localhost; Soma itself makes no network calls. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- "Use my location" in settings; coarse is enough for sunrise and muhurat. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- Vrat, parana, daily panchang and Rahu Kaal reminders (the notifications plugin adds exact alarms and boot re-arming). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
